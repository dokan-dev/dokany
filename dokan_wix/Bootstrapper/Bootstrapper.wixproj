<Project Sdk="WixToolset.Sdk/5.0.1">
  <PropertyGroup>
    <ProductVersion>3.9</ProductVersion>
    <OutputName>DokanSetup</OutputName>
    <OutputType>Bundle</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>Debug</DefineConstants>
    <LinkerAdditionalOptions>-sw1132</LinkerAdditionalOptions>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <LinkerAdditionalOptions>-sw1132</LinkerAdditionalOptions>
    <SignOutput Condition="'$(SIGNTOOL)' != '' and '$(SHA1_CERTTHUMBPRINT)' != '' and '$(SHA2_CERTTHUMBPRINT)' != ''">true</SignOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Dependency.wixext" Version="5.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.1" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\dokan.png" />
    <Content Include="Resources\licdata.rtf" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources" />
  </ItemGroup>
  <Target Name="SignBundleEngine">
    <Exec Command="&quot;%25SIGNTOOL%25&quot; sign /v /fd sha1 /sha1 &quot;%25SHA1_CERTTHUMBPRINT%25&quot; /t http://timestamp.digicert.com &quot;%(SignBundleEngine.FullPath)&quot;" />
    <Exec Command="&quot;%25SIGNTOOL%25&quot; sign /v /tr http://timestamp.digicert.com /td sha256 /fd sha256 /as /sha1 &quot;%25SHA2_CERTTHUMBPRINT%25&quot; &quot;%(SignBundleEngine.FullPath)&quot;" />
  </Target>
  <Target Name="SignBundle">
    <Exec Command="&quot;%25SIGNTOOL%25&quot; sign /v /fd sha1 /sha1 &quot;%25SHA1_CERTTHUMBPRINT%25&quot; /t http://timestamp.digicert.com &quot;%(SignBundle.FullPath)&quot;" />
    <Exec Command="&quot;%25SIGNTOOL%25&quot; sign /v /tr http://timestamp.digicert.com /td sha256 /fd sha256 /as /sha1 &quot;%25SHA2_CERTTHUMBPRINT%25&quot; &quot;%(SignBundle.FullPath)&quot;" />
  </Target>
</Project>